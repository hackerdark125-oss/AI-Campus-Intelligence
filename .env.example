# Copy this file to .env and fill in real values before running docker-compose,
# or export these as environment variables for local (non-Docker) runs.

# --- Database ---
# Local dev default (no setup needed): sqlite:///./campus.db
# Docker/production: set by docker-compose.yml automatically (Postgres)
DATABASE_URL=sqlite:///./campus.db

# --- Auth ---
# Generate a real random value for production, e.g.: openssl rand -hex 32
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Face recognition ---
FACE_CONFIDENCE_THRESHOLD=65

# --- RAG chatbot ---
# Optional. Without this, the chatbot still works but returns the most relevant
# retrieved passage directly instead of an AI-generated answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
RAG_TOP_K=3

# --- Analytics ---
ATTENDANCE_RISK_THRESHOLD=75.0
